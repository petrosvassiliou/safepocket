-- SafePocket Encrypted Local Vault Schema
-- Underlying storage:
--   • Android 17+ & Googlebook OS: SQLCipher 4.6 (AES-256-CBC/GCM page encryption, 4096B pages)
--   • macOS Desktop: SQLCipher via NativeSqliteDriver
--   • ChromeOS PWA: SQLite WASM backed by Origin Private File System (OPFS) + item-level AES-256-GCM

CREATE TABLE IF NOT EXISTS vault_header (
    vault_id TEXT NOT NULL PRIMARY KEY,
    schema_version INTEGER NOT NULL DEFAULT 1,
    kdf_algorithm TEXT NOT NULL DEFAULT 'Argon2id-v1.3',
    kdf_memory_kib INTEGER NOT NULL DEFAULT 65536,
    kdf_iterations INTEGER NOT NULL DEFAULT 3,
    kdf_parallelism INTEGER NOT NULL DEFAULT 4,
    kdf_salt BLOB NOT NULL,
    secret_key_fingerprint TEXT NOT NULL,
    wrapped_vault_key BLOB NOT NULL,
    wrapped_vault_key_iv BLOB NOT NULL,
    cloud_sync_enabled INTEGER NOT NULL DEFAULT 0, -- 0 = Local Storage Only (Default); 1 = Cloud Sync Opt-In
    cloud_provider TEXT NOT NULL DEFAULT 'FIREBASE', -- 'FIREBASE' (Default Cloud Service) | 'GOOGLE_DRIVE_APPDATA' (Optional)
    created_at INTEGER NOT NULL,
    last_unlocked_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS vault_items (
    id TEXT NOT NULL PRIMARY KEY,
    category TEXT NOT NULL, -- PAYMENT_CARD | IDENTITY | OFFICIAL_DOCUMENT | SECURE_NOTE
    is_favorite INTEGER NOT NULL DEFAULT 0,
    expiry_epoch_day INTEGER, -- Optional indexed day bucket (coarse) or NULL; decrypted details stay in ciphertext
    encrypted_payload BLOB NOT NULL, -- AES-256-GCM(VEK, IV, PlaintextJSON, AAD=id||category||schema_version)
    iv BLOB NOT NULL, -- 96-bit CSPRNG nonce
    schema_version INTEGER NOT NULL DEFAULT 1,
    hlc_timestamp TEXT NOT NULL, -- Hybrid Logical Clock (e.g. 2026-11-15T18:58:00.000Z-0001-nodeA)
    version_vector_json TEXT NOT NULL, -- Per-device causal version vector {"android-px9": 4, "chromeos-pwa": 2}
    is_tombstone INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_vault_items_category ON vault_items(category, is_tombstone);
CREATE INDEX IF NOT EXISTS idx_vault_items_hlc ON vault_items(hlc_timestamp);

CREATE TABLE IF NOT EXISTS vault_attachments (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL REFERENCES vault_items(id) ON DELETE CASCADE,
    encrypted_metadata BLOB NOT NULL, -- Encrypted filename + mimeType + dimensions
    metadata_iv BLOB NOT NULL,
    wrapped_file_key BLOB NOT NULL, -- Per-attachment 256-bit DEK wrapped by Vault Encryption Key
    file_key_iv BLOB NOT NULL,
    blob_sha256 TEXT NOT NULL,
    blob_size_bytes INTEGER NOT NULL,
    local_blob_path TEXT, -- Encrypted file chunk path or OPFS handle
    hlc_timestamp TEXT NOT NULL,
    is_tombstone INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_attachments_item ON vault_attachments(item_id);

CREATE TABLE IF NOT EXISTS sync_delta_queue (
    seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    op_id TEXT NOT NULL UNIQUE,
    entity_type TEXT NOT NULL, -- ITEM | ATTACHMENT
    entity_id TEXT NOT NULL,
    hlc_timestamp TEXT NOT NULL,
    encrypted_envelope BLOB NOT NULL,
    iv BLOB NOT NULL,
    queued_at INTEGER NOT NULL,
    synced_firebase INTEGER NOT NULL DEFAULT 0,
    synced_gdrive INTEGER NOT NULL DEFAULT 0
);

selectAllActiveItems:
SELECT * FROM vault_items
WHERE is_tombstone = 0
ORDER BY updated_at DESC;

upsertVaultItem:
INSERT OR REPLACE INTO vault_items(
    id, category, is_favorite, expiry_epoch_day,
    encrypted_payload, iv, schema_version,
    hlc_timestamp, version_vector_json, is_tombstone, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

enqueueSyncDelta:
INSERT INTO sync_delta_queue(
    op_id, entity_type, entity_id, hlc_timestamp, encrypted_envelope, iv, queued_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

pendingDeltasForProvider:
SELECT * FROM sync_delta_queue
WHERE (:provider = 'FIREBASE' AND synced_firebase = 0)
   OR (:provider = 'GDRIVE' AND synced_gdrive = 0)
ORDER BY seq ASC;

markVaultItemTombstone:
UPDATE vault_items
SET is_tombstone = 1,
    encrypted_payload = :emptyCiphertext,
    iv = :tombstoneIv,
    hlc_timestamp = :hlcTimestamp,
    version_vector_json = :versionVectorJson,
    updated_at = :updatedAt
WHERE id = :id;

selectItemsIncludingTombstonesSinceHlc:
SELECT * FROM vault_items
WHERE (:sinceHlc IS NULL OR hlc_timestamp > :sinceHlc)
ORDER BY hlc_timestamp ASC;

