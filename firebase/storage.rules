rules_version = '2';

// SafePocket Zero-Knowledge Firebase Cloud Storage Rules
// Stores ONLY client-encrypted `.enc` attachment blobs (`AES-256-GCM`) with mandatory SHA-256 metadata.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/vaults/{vaultId}/blobs/{blobFile} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && blobFile.matches('^[a-zA-Z0-9_-]+\\.enc$')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata != null
        && 'ciphertextSha256' in request.resource.metadata
        && request.resource.metadata.ciphertextSha256.matches('^[a-fA-F0-9]{64}$');
    }
  }
}
